# ----------------------------------------------------------------------
# 1. COMPRESSÃO GZIP (Otimização de Velocidade)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  # Comprime HTML, CSS, JS, XML e Fontes
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/otf font/ttf application/x-font-ttf
</IfModule>

# ----------------------------------------------------------------------
# 2. SEGURANÇA (Proteção do Sistema)
# ----------------------------------------------------------------------
# Impede listagem de pastas (Segurança básica)
Options -Indexes

# Oculta assinatura do servidor (Evita expor versão do Apache/PHP)
ServerSignature Off

# Bloqueia acesso a arquivos sensíveis (.git, .env, .htaccess, etc)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ----------------------------------------------------------------------
# 3. CACHE INTELIGENTE (Modo Desenvolvimento/Teste)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # --- ARQUIVOS ESTÁTICOS (Imagens, Fontes, Vídeos) ---
    # Esses raramente mudam, então guardamos por 1 semana para economizar dados
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|otf|mp4|webm)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>

    # --- ARQUIVOS DE LÓGICA (CSS, JS, PHP, HTML) ---
    # AQUI ESTÁ O SEGREDO: "no-cache" não significa "não guardar".
    # Significa: "Guarde, mas PERGUNTE ao servidor se mudou antes de usar".
    # Se você editar o arquivo, o navegador baixa o novo na hora.
    <FilesMatch "\.(css|js|php|html|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 4. PERSONALIZAÇÃO DE ERROS (Opcional - Melhora a experiência)
# ----------------------------------------------------------------------
# Se der erro 404 ou 500, o usuário não vê aquela tela feia do servidor
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php