# ----------------------------------------------------------------------
# 1. COMPRESSÃO GZIP (Deixa o site rápido sem travar atualizações)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/otf font/ttf application/x-font-ttf
</IfModule>

# ----------------------------------------------------------------------
# 2. SEGURANÇA BÁSICA (Essencial)
# ----------------------------------------------------------------------
# Impede listagem de diretórios (para ninguém ver seus arquivos soltos)
Options -Indexes

# Bloqueia acesso a arquivos ocultos (como o próprio .htaccess)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ----------------------------------------------------------------------
# 3. FORÇAR REVALIDAÇÃO (Opcional, mas bom para testes)
# ----------------------------------------------------------------------
# Garante que o navegador pergunte ao servidor se o arquivo mudou
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif)$">
        FileETag None
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>
</IfModule>